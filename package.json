{
  "name": "bloop-orbit",
  "private": true,
  "version": "1.2.26",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json",
    "cap:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew bundleRelease assembleRelease",
    "assets": "node scripts/render-assets.mjs && npx @capacitor/assets generate --android --assetPath assets",
    "worker:dev": "wrangler dev --local",
    "worker:deploy": "npm run build && wrangler deploy",
    "test:server": "node scripts/test-server.mjs",
    "test:ai": "node scripts/test-ai-pet.mjs",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:check": "node scripts/i18n/extract.mjs --check",
    "i18n:apply": "node scripts/i18n/apply.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@capacitor-community/admob": "^8.3.0",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/geolocation": "^8.2.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/screen-orientation": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/native-purchases": "^8.9.6",
    "@fontsource/fredoka": "^5.3.0",
    "@mediapipe/tasks-vision": "0.10.35",
    "cannon-es": "^0.20.0",
    "planck": "^1.4.2",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/three": "^0.170.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "wrangler": "^4.158.0"
  }
}
