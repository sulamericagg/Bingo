// Configuração do Cloudflare Worker "bloop-orbit".
// Serve o jogo (dist/), a API (/api/*) e o painel admin (/admin).
// Deploy: npm run build && npx wrangler deploy   (veja docs/PAINEL-ADMIN.md)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloop-orbit",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  // Hash PBKDF2 da senha do painel admin (seguro em público). O segredo ADMIN_PASSWORD, se existir, tem prioridade.
  "vars": { "ADMIN_PASSWORD_HASH": "pbkdf2:100000:bc2d3d18e294745b5ddf0c25cae18ddf:711891b6519b683eef6ccfbf4d9ad2a1ef77e91ebf8cdf98b132a1e16050f4c1" },
  // Workers AI: o Whisper transcreve as vozes dos filmes enviados para a TV Bloop antes da moderação
  // (server/voice-mod.ts, docs/LOJA-TV.md). No `wrangler dev` o binding chama a nuvem (precisa de login);
  // o teste local usa AI_STT_MOCK=device no .dev.vars.
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    // sem "id": o banco KV é criado automaticamente na conta no primeiro deploy
    { "binding": "DATA" }
  ],
  // Corrida Orbital: Durable Object com SQLite (disponível no plano grátis).
  "durable_objects": {
    "bindings": [
      { "name": "RACE", "class_name": "RaceRoom" },
      // Social (docs/SOCIAL.md): presença drop-in, chat moderado e campeonatos.
      { "name": "PRESENCE", "class_name": "PresenceRoom" },
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "CHAMP", "class_name": "Championship" },
      // Casa, Planeta & Amigos (docs/CASA-AMIGOS.md): festas por anfitrião + amizades.
      { "name": "PARTY", "class_name": "PartyRoom" },
      { "name": "FRIENDS", "class_name": "FriendsHub" },
      // Grupo (party de até 4) com chat e "jogar junto" (docs/PARTY.md).
      { "name": "SQUAD", "class_name": "SquadRoom" },
      // Pouso Forçado online: sala de voo por código (relé) + convites entre amigos.
      { "name": "FLIGHT", "class_name": "FlightRoom" },
      // Painel admin: códigos (limites atômicos), resgates de presentes, compras reportadas e auditoria.
      { "name": "ADMIN", "class_name": "AdminHub" },
      // Noites do Acampamento: sala co-op por código (relé; o anfitrião simula).
      { "name": "NIGHTS", "class_name": "NightsRoom" },
      // Mundo Aberto online (docs/MUNDO-MOTOR.md): mundos de até 8 com edições guardadas.
      { "name": "MUNDO", "class_name": "WorldRoom" },
      // Loja de Criações do Bloop Studio + fila de moderação (docs/LOJA-TV.md).
      { "name": "UGC", "class_name": "UgcHub" },
      // TV Bloop: canal ao vivo com os filmes aprovados do Bloop Cinema.
      { "name": "TV", "class_name": "TvChannel" },
      // Garimpo Bruto online: sala por código (relé; o anfitrião simula com o save dele) + convites.
      { "name": "GARIMPO", "class_name": "GarimpoRoom" },
      // Cava & Fala online: arena/vila por código (relé; o anfitrião manda na partida) + convites.
      { "name": "CAVA", "class_name": "CavaRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] },
    { "tag": "v2-social", "new_sqlite_classes": ["PresenceRoom", "ChatRoom", "Championship"] },
    { "tag": "v3-home", "new_sqlite_classes": ["PartyRoom", "FriendsHub"] },
    { "tag": "v4-squad", "new_sqlite_classes": ["SquadRoom"] },
    { "tag": "v4-voo", "new_sqlite_classes": ["FlightRoom"] },
    { "tag": "v5-admin", "new_sqlite_classes": ["AdminHub"] },
    { "tag": "v5-noites", "new_sqlite_classes": ["NightsRoom"] },
    { "tag": "v6-mundo", "new_sqlite_classes": ["WorldRoom"] },
    { "tag": "v7-loja-tv", "new_sqlite_classes": ["UgcHub", "TvChannel"] },
    { "tag": "v8-garimpo", "new_sqlite_classes": ["GarimpoRoom"] },
    { "tag": "v10-cava", "new_sqlite_classes": ["CavaRoom"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
  // O segredo ADMIN_PASSWORD NÃO fica aqui: configure em
  // Cloudflare → Workers & Pages → bloop-orbit → Settings → Variables and Secrets.
}
