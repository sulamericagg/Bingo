// Configuração do Cloudflare Worker "bloop-orbit".
// Serve o jogo (dist/), a API (/api/*) e o painel admin (/admin).
// Deploy: npm run build && npx wrangler deploy   (veja docs/PAINEL-ADMIN.md)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloop-orbit",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin*"]
  },
  "kv_namespaces": [
    { "binding": "DATA", "id": "3c7cece821ee4d6297ce2db9f664b948" }
  ],
  // Corrida Orbital: Durable Object com SQLite (disponível no plano grátis).
  "durable_objects": {
    "bindings": [
      { "name": "RACE", "class_name": "RaceRoom" },
      // Social (docs/SOCIAL.md): presença drop-in, chat moderado e campeonatos.
      { "name": "PRESENCE", "class_name": "PresenceRoom" },
      { "name": "CHAT", "class_name": "ChatRoom" },
      { "name": "CHAMP", "class_name": "Championship" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RaceRoom"] },
    { "tag": "v2-social", "new_sqlite_classes": ["PresenceRoom", "ChatRoom", "Championship"] }
  ],
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
  // O segredo ADMIN_PASSWORD NÃO fica aqui: configure em
  // Cloudflare → Workers & Pages → bloop-orbit → Settings → Variables and Secrets.
}
